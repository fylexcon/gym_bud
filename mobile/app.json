{
  "expo": {
    "newArchEnabled": false,
    "experiments": {
      "newArchEnabled": false
    },
    "name": "GymBud",
    "slug": "gymbud",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymbud.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GymBud needs camera access for daily physique check-ins.",
        "NSPhotoLibraryUsageDescription": "GymBud needs photo library access to select physique photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.gymbud.app",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#6C63FF"
        }
      ],
      "expo-font"
    ]
  }
}
