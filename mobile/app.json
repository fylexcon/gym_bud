{
  "expo": {
    "newArchEnabled": false,
    "name": "GymBud",
    "slug": "gymbud",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymbud.app",
      "infoPlist": {
        "NSCameraUsageDescription": "GymBud needs camera access for daily physique check-ins.",
        "NSPhotoLibraryUsageDescription": "GymBud needs photo library access to select physique photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F"
      },
      "package": "com.gymbud.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "expo-notifications",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "ad4ffff2-e95e-4bd8-b3d2-feb8ad46f926"
      }
    }
  }
}
